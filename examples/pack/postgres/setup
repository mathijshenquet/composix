set -eu
. /opt/postgres/runtime-env.sh

if [ ! -s "$data_dir/PG_VERSION" ]; then
  rm -rf "$init_dir"
  mkdir -p "$init_dir"
  LANG=C LC_ALL=C initdb \
    --pgdata="$init_dir" \
    --username=cix \
    --auth-local=trust \
    --auth-host=trust \
    --encoding=UTF8 \
    --no-locale
  mv "$init_dir" "$data_dir"
fi
