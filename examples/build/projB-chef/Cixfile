FROM github:NixOS/nixpkgs/nixos-unstable AS pkgs
FROM . AS src

BUILDER build
PATH ${pkgs.bash}/bin ${pkgs.cargo}/bin ${pkgs.rustc}/bin ${pkgs.cargo-chef}/bin ${pkgs.gcc}/bin ${pkgs.coreutils}/bin

COPY ${src}/recipe.json recipe.json
FETCH SSL_CERT_FILE=${pkgs.cacert}/etc/ssl/certs/ca-bundle.crt cargo chef cook --release --recipe-path recipe.json
RUN cargo chef cook --release --offline --recipe-path recipe.json
COPY ${src}/Cargo.toml Cargo.toml
COPY ${src}/Cargo.lock Cargo.lock
COPY ${src}/src/main.rs src/main.rs
RUN cargo build --release --locked --offline

SERVICE projb-chef
COPY ${build}/target/release/projb-chef bin/projb-chef
EXEC bin/projb-chef
PORT http = 18083
