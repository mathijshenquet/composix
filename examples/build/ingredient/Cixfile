FROM github:NixOS/nixpkgs/nixos-unstable AS pkgs

BUILDER payload
  IMPORT ${pkgs.bash} ${pkgs.curl} ${pkgs.cacert}
  FETCH EXPECT sha256-XhP7EsnseO1i7z6hXTRfJ17kuLWNtxv0r2fWrgOpz58= \
      curl --fail --location \
      https://raw.githubusercontent.com/NixOS/nixpkgs/624af665418d3c65d544145b4d34ad696439570e/README.md \
      --output README.md

SERVICE ingredient
  COPY ${payload}/README.md /share/nixpkgs-README.md
  START ${pkgs.coreutils}/bin/sleep infinity
