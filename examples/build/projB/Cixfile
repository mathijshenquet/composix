FROM github:NixOS/nixpkgs/nixos-unstable AS pkgs
FROM . AS src

BUILDER build
IMPORT ${pkgs.bash} ${pkgs.cargo} ${pkgs.rustc} \
    ${pkgs.gcc} ${pkgs.coreutils} ${pkgs.cacert}

# Fetch from manifests first so source-only edits reuse the dependency snapshot.
COPY ${src}/Cargo.toml Cargo.toml
COPY ${src}/Cargo.lock Cargo.lock
FETCH cargo fetch --locked
COPY ${src}/src/ src
RUN cargo build --release --locked --offline

SERVICE projb
COPY ${build}/target/release/projb bin/projb
EXEC bin/projb
PORT http = 18082
