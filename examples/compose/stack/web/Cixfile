FROM github:NixOS/nixpkgs/nixos-unstable AS pkgs
FROM . AS src

SERVICE nginx
COPY ${src}/nginx.conf etc/nginx/nginx.conf
LINK ${pkgs.nginx}/bin/nginx bin/nginx
LINK ${pkgs.nginx}/conf/mime.types /etc/nginx/mime.types
SCRIPT bin/start <<SH
set -eu
test "$LISTEN_FDS" = 1
test "$LISTEN_FDNAMES" = http
export NGINX='3;'
exec "$("${pkgs.coreutils}/bin/dirname" "$0")/nginx" -c /etc/nginx/nginx.conf -e stderr
SH

EXEC bin/start
LISTENER http
CACHEDIR /var/cache/nginx
RUNDIR /run/nginx
