FROM github:NixOS/nixpkgs/nixos-unstable AS pkgs
FROM . AS src

BUILDER build
COPY ${src}/nginx.conf etc/nginx/nginx.conf

SERVICE nginx
COPY ${build}/etc/nginx/nginx.conf etc/nginx/nginx.conf
LINK bin/nginx ${pkgs.nginx}/bin/nginx
LINK /etc/nginx/mime.types ${pkgs.nginx}/conf/mime.types
SCRIPT bin/start <<SH
set -eu
test "$LISTEN_FDS" = 1
test "$LISTEN_FDNAMES" = http
export NGINX='3;'
exec "$("${pkgs.coreutils}/bin/dirname" "$0")/nginx" -c /etc/nginx/nginx.conf -e stderr
SH

EXEC bin/start
LISTENER http
CACHE /var/cache/nginx
RUNDIR /run/nginx
