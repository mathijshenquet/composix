LINK bin/nginx ${pkgs.nginx}/bin/nginx
LINK /etc/nginx/mime.types ${pkgs.nginx}/conf/mime.types
COPY nginx.conf /etc/nginx/nginx.conf

SCRIPT bin/start <<SH
set -eu
test "$LISTEN_FDS" = 1
test "$LISTEN_FDNAMES" = http
export NGINX='3;'
exec "$("${pkgs.coreutils}/bin/dirname" "$0")/nginx" -c /etc/nginx/nginx.conf -e stderr
SH

SERVICE nginx
EXEC bin/start
LISTENER http
CACHE /var/cache/nginx
RUNDIR /run/nginx
