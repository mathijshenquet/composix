PKG postgresql
PKG python3

LINK bin/psql ${postgresql}/bin/psql
LINK bin/python3 ${python3}/bin/python3
LINK share/postgresql ${postgresql}/share/postgresql
COPY greeting.txt /srv/backend/greeting.txt

FILE bin/backend.py <<PY
import os
from pathlib import Path
import socket
import subprocess

socket_path = "/run/backend/backend.sock"
try:
    os.unlink(socket_path)
except FileNotFoundError:
    pass

server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
server.bind(socket_path)
os.chmod(socket_path, 0o660)
server.listen()

item_dir = Path(__file__).resolve().parent.parent
greeting = Path("/srv/backend/greeting.txt").read_text().strip()

while True:
    connection, _ = server.accept()
    with connection:
        request = b""
        while b"\r\n\r\n" not in request:
            chunk = connection.recv(4096)
            if not chunk:
                break
            request += chunk
        query = subprocess.run(
            [
                str(item_dir / "bin/psql"),
                "--host=/run/postgresql",
                "--username=cix",
                "--tuples-only",
                "--no-align",
                "--command=SELECT 'database-ok'",
            ],
            check=True,
            capture_output=True,
            text=True,
        ).stdout.strip()
        body = f"{greeting}{os.environ['SUFFIX']}: {query}\n".encode()
        connection.sendall(
            b"HTTP/1.1 200 OK\r\n"
            + b"Content-Type: text/plain\r\n"
            + f"Content-Length: {len(body)}\r\n".encode()
            + b"Connection: close\r\n\r\n"
            + body
        )
PY

SCRIPT bin/start <<SH
set -eu
item_dir="$("${python3}/bin/python3" -c 'import pathlib,sys; print(pathlib.Path(sys.argv[1]).resolve().parent.parent)' "$0")"
exec "$item_dir/bin/python3" "$item_dir/bin/backend.py"
SH

SERVICE backend
EXEC bin/start
ENV SUFFIX
RUNDIR /run/backend
