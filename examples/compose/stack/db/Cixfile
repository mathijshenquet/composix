PKG coreutils
PKG nss_wrapper
PKG postgresql

LINK bin/id ${coreutils}/bin/id
LINK bin/mkdir ${coreutils}/bin/mkdir
LINK bin/mv ${coreutils}/bin/mv
LINK bin/rm ${coreutils}/bin/rm
LINK bin/initdb ${postgresql}/bin/initdb
LINK bin/postgres ${postgresql}/bin/postgres
LINK lib ${postgresql}/lib
LINK nss/libnss_wrapper.so ${nss_wrapper}/lib/libnss_wrapper.so
LINK share/postgresql ${postgresql}/share/postgresql

FILE share/runtime-env.sh <<EOF
state_dir=/var/lib/postgresql
data_dir="$state_dir/data"
init_dir="$state_dir/.init"
item_dir="$("${coreutils}/bin/dirname" "$0")/.."
uid="$("$item_dir/bin/id" -u)"
gid="$("$item_dir/bin/id" -g)"

printf 'cix:x:%s:%s:PostgreSQL:%s:/noshell\n' \
  "$uid" "$gid" "$state_dir" > "$state_dir/passwd"
printf 'cix:x:%s:\n' "$gid" > "$state_dir/group"
export NSS_WRAPPER_PASSWD="$state_dir/passwd"
export NSS_WRAPPER_GROUP="$state_dir/group"
export LD_PRELOAD="$item_dir/nss/libnss_wrapper.so"
EOF

SCRIPT bin/setup <<EOF
set -eu
. "$("${coreutils}/bin/dirname" "$0")/../share/runtime-env.sh"

if [ ! -s "$data_dir/PG_VERSION" ]; then
  "$item_dir/bin/rm" -rf "$init_dir"
  "$item_dir/bin/mkdir" -p "$init_dir"
  LANG=C LC_ALL=C "$item_dir/bin/initdb" \
    --pgdata="$init_dir" \
    --username=cix \
    --auth-local=trust \
    --encoding=UTF8 \
    --no-locale
  "$item_dir/bin/mv" "$init_dir" "$data_dir"
fi
EOF

SCRIPT bin/start <<EOF
set -eu
. "$("${coreutils}/bin/dirname" "$0")/../share/runtime-env.sh"

exec "$item_dir/bin/postgres" \
  -D "$data_dir" \
  -c listen_addresses= \
  -c unix_socket_directories=/run/postgresql \
  -c unix_socket_permissions=0770
EOF

SERVICE postgres
SETUP bin/setup
EXEC bin/start
STATE /var/lib/postgresql
RUNDIR /run/postgresql
