FROM github:NixOS/nixpkgs/nixos-unstable AS pkgs

SERVICE nginx
  FILE /etc/nginx/nginx.conf <<NGINX
daemon off;
events { }
http {
  access_log off;
  server {
    listen 8080;
    location / { return 200 "nginx\n"; }
  }
}
NGINX
  LOGDIR /var/log/nginx
  RUNDIR /run/nginx
  START ${pkgs.nginx}/bin/nginx -c /etc/nginx/nginx.conf -e stderr
  PORT http = 8080
