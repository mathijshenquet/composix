FROM github:NixOS/nixpkgs/nixos-unstable AS pkgs
FROM . AS src

BUILDER build
IMPORT ${pkgs.bash} ${pkgs.coreutils} ${pkgs.nodejs_22} ${pkgs.python3} \
    ${pkgs.gnumake} ${pkgs.gcc} ${pkgs.git} ${pkgs.cacert}
ENV npm_config_fetch_retries = 5
ENV npm_config_fetch_retry_mintimeout = 60000
ENV npm_config_fetch_retry_maxtimeout = 300000
COPY ${src}/context/ .
FETCH npm ci --ignore-scripts --no-audit --no-fund
RUN npm run build
RUN npm prune --omit=dev --ignore-scripts --offline --no-audit --no-fund

SERVICE parse-server
COPY ${build}/node_modules /parse-server/node_modules
COPY ${build}/lib /parse-server/lib
COPY ${build}/bin/parse-server /parse-server/bin/parse-server
COPY ${build}/package.json /parse-server/package.json
COPY ${build}/package-lock.json /parse-server/package-lock.json
COPY ${build}/public /parse-server/public
COPY ${build}/views /parse-server/views
LINK ${pkgs.nodejs_22}/bin/node /bin/node
EXEC node /parse-server/bin/parse-server
ENV PORT = 18091
ENV PARSE_SERVER_APPLICATION_ID required
ENV PARSE_SERVER_MASTER_KEY secret
ENV PARSE_SERVER_DATABASE_URI required
ENV PARSE_SERVER_URL required
ENV PARSE_SERVER_LOGS_FOLDER = /var/log/parse-server
PORT http = $PORT
LOGSDIR /var/log/parse-server
GRANT egress
GRANT jit
