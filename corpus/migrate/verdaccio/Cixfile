FROM github:NixOS/nixpkgs/nixos-unstable AS pkgs
FROM . AS src

BUILDER build
  IMPORT ${pkgs.bash} ${pkgs.coreutils} ${pkgs.nodejs_24} ${pkgs.pnpm} ${pkgs.gnused} ${pkgs.cacert}
  ENV COREPACK_HOME = $PWD/.corepack
  COPY ${src}/context/ .
  FETCH corepack install
  RUN pnpm config set store-dir $PWD/.pnpm-store
  FETCH pnpm fetch --frozen-lockfile
  RUN pnpm install --offline --frozen-lockfile --ignore-scripts
  RUN pnpm run build
  RUN pnpm --filter verdaccio --prod --legacy deploy deploy
  COPY ${src}/context/packages/config/src/conf/docker.yaml config.yaml
  RUN sed -e 's@/verdaccio/storage@/var/lib/verdaccio@g' -e 's@/verdaccio/plugins@/var/lib/verdaccio/plugins@g' config.yaml > config.cix.yaml

SERVICE verdaccio
  COPY ${build}/deploy /app
  COPY ${build}/config.cix.yaml /etc/verdaccio/config.yaml
  STATEDIR /var/lib/verdaccio
  LINK ${pkgs.nodejs_24}/bin/node /bin/node
  EXEC node /app/bin/verdaccio --config /etc/verdaccio/config.yaml --listen http://0.0.0.0:4873
  PORT http = 4873
  CLAIM jit
  CLAIM egress
