FROM github:NixOS/nixpkgs/nixos-unstable AS pkgs
FROM . AS src

BUILDER ui
  IMPORT ${pkgs.bash} ${pkgs.coreutils} ${pkgs.nodejs_24} ${pkgs.pnpm} ${pkgs.gnused} ${pkgs.cacert}
  ENV COREPACK_HOME = $PWD/.corepack
  COPY ${src}/context/ .
  FETCH corepack install
  RUN pnpm config set store-dir $PWD/.pnpm-store
  FETCH pnpm fetch --ignore-scripts
  RUN pnpm install --offline --ignore-scripts
  RUN pnpm build

BUILDER build
  IMPORT ${pkgs.bash} ${pkgs.coreutils} ${pkgs.go} ${pkgs.gcc} ${pkgs.cacert}
  ENV GOMODCACHE = $PWD/.gomodcache
  COPY ${src}/context/ .
  COPY ${ui}/dist dist
  FETCH go mod download
  RUN CGO_ENABLED=0 go build -o dozzle

SERVICE dozzle
  COPY ${build}/dozzle /bin/dozzle
  STATEDIR /var/lib/dozzle
  EXEC dozzle
  PORT http = 8080
