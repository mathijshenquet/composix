FROM github:NixOS/nixpkgs/nixos-unstable AS pkgs

BUILDER build
  PATH ${pkgs.bash}/bin ${pkgs.git}/bin ${pkgs.go}/bin \
    ${pkgs.gnumake}/bin
  # Each networked stage is independently pinned; RUN only consumes its snapshot.
  FETCH ${pkgs.git}/bin/git -c http.sslCAInfo=${pkgs.cacert}/etc/ssl/certs/ca-bundle.crt clone https://github.com/traefik/whoami.git .
  FETCH SSL_CERT_FILE=${pkgs.cacert}/etc/ssl/certs/ca-bundle.crt GOMODCACHE=$PWD/.gomodcache ${pkgs.go}/bin/go mod download
  RUN GOMODCACHE=$PWD/.gomodcache make build

SERVICE whoami
  COPY ${build}/whoami bin/whoami
  EXEC bin/whoami
  PORT http = 80
