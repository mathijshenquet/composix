FROM github:NixOS/nixpkgs/nixos-unstable AS pkgs

BUILDER build
  IMPORT ${pkgs.bash} ${pkgs.git} ${pkgs.go} ${pkgs.gnumake} ${pkgs.cacert}
  ENV GOMODCACHE = $PWD/.gomodcache
  # Each networked stage is independently pinned; RUN only consumes its snapshot.
  FETCH git clone https://github.com/traefik/whoami.git .
  FETCH go mod download
  RUN make build

SERVICE whoami
  COPY ${build}/whoami bin/whoami
  EXEC whoami
  PORT http = 80
