FROM github:NixOS/nixpkgs/nixos-unstable AS pkgs

BUILDER package3
  IMPORT ${pkgs.bash} ${pkgs.cacert} ${pkgs.coreutils} ${pkgs.curl} ${pkgs.findutils} ${pkgs.gnupg} ${pkgs.gnused} ${pkgs.gnutar} ${pkgs.xz}
  ENV VERSION=5.2.3
  ENV SHA256=57881348297c4412f86c410547cf76b4d8a236574dd2c6b7d6a2beebe7fc44e3
  ENV URL=https://files.phpmyadmin.net/phpMyAdmin/$VERSION/phpMyAdmin-$VERSION-all-languages.tar.xz
  FETCH bash -c 'set -eu; export GNUPGHOME="$PWD/gnupg"; mkdir -m 700 "$GNUPGHOME"; curl --fail --location --output phpMyAdmin.tar.xz "$URL"; curl --fail --location --output phpMyAdmin.tar.xz.asc "$URL.asc"; echo "$SHA256 *phpMyAdmin.tar.xz" | sha256sum -c -; curl --fail --location https://keys.openpgp.org/vks/v1/by-fingerprint/3D06A59ECE730EB71B511C17CE752F178259BD92 | gpg --batch --import; gpg --batch --verify phpMyAdmin.tar.xz.asc phpMyAdmin.tar.xz; gpgconf --kill all; rm -rf "$GNUPGHOME"' EXPECT sha256-0UThvehGmRwp33q84MI46oZv0gZMGeQ3T9xaObyPlKw=
  RUN mkdir -p output
  RUN <<BUILD
tar -xf phpMyAdmin.tar.xz
chmod -R u+w output || true
rm -rf output/html
mv phpMyAdmin-$VERSION-all-languages output/html
mkdir -p output/html/tmp
rm -rf output/html/setup output/html/examples output/html/js/src output/html/babel.config.json output/html/doc/html/_sources output/html/RELEASE-DATE-$VERSION output/html/CONTRIBUTING.md
rm -f output/html/libraries/vendor_config.php.new
sed "s@'configFile' => .*@'configFile' => '/etc/phpmyadmin/config.inc.php',@" output/html/libraries/vendor_config.php > output/html/libraries/vendor_config.php.new
mv output/html/libraries/vendor_config.php.new output/html/libraries/vendor_config.php
find output/html -type d -exec chmod 555 {} \;
find output/html -type f -exec chmod 444 {} \;
chmod 1777 output/html/tmp
BUILD

SERVICE phpmyadmin
  IMPORT ${pkgs.bash} ${pkgs.coreutils} ${pkgs.php}
  COPY ${package3}/output/html /var/www/html
  COPY context/config.inc.php /share/phpmyadmin-config.inc.php
  COPY context/helpers.php /share/phpmyadmin-helpers.php
  COPY start-pre.sh /bin/phpmyadmin-start-pre
  START_PRE bash /bin/phpmyadmin-start-pre
  START php -S 0.0.0.0:8080 -t /var/www/html
  ENV PMA_SSL_DIR=/etc/phpmyadmin/ssl
  ENV MAX_EXECUTION_TIME=600
  ENV MEMORY_LIMIT=512M
  ENV UPLOAD_LIMIT=2048K
  ENV TZ=UTC
  ENV SESSION_SAVE_PATH=/sessions
  ENV PHP_INI_SCAN_DIR=/etc/phpmyadmin
  PORT http = 8080
  CLAIM egress
  RUNDIR /etc/phpmyadmin
  CACHEDIR /sessions
