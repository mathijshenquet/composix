FROM github:NixOS/nixpkgs/nixos-unstable AS pkgs

SERVICE watchtower
  IMPORT ${pkgs.glibc} ${pkgs.cacert} ${pkgs.tzdata}
  COPY context/oryxBuildBinary /watchtower
  COPY ${pkgs.cacert}/etc/ssl/certs/ca-bundle.crt /etc/ssl/certs/ca-certificates.crt
  COPY ${pkgs.tzdata}/share/zoneinfo /usr/share/zoneinfo
  START /watchtower
  PORT http = 8080
  CLAIM egress
  DIR /var/run/docker.sock:ro
