FROM github:NixOS/nixpkgs/nixos-unstable AS pkgs
FROM . AS src

BUILDER release
  IMPORT ${pkgs.bash} ${pkgs.cacert} ${pkgs.coreutils} ${pkgs.curl} ${pkgs.gnutar} ${pkgs.gzip}
  ENV FILEBROWSER_VERSION=2.63.23
  ENV FILEBROWSER_ARCH=amd64
  ENV FILEBROWSER_SHA256=b14db2bb8033caa3f80205eb6578b2ed0744ebd9e716b790bc4a9703ce909e88
  FETCH curl --fail --location https://github.com/filebrowser/filebrowser/releases/download/v$FILEBROWSER_VERSION/linux-$FILEBROWSER_ARCH-filebrowser.tar.gz --output filebrowser.tar.gz && echo "$FILEBROWSER_SHA256  filebrowser.tar.gz" | sha256sum --check --status EXPECT sha256-k6239590pl8k4UojhPb4QmwjmlZwvlJ2ta9fsXC9wIM=
  RUN <<BUILD
tar --no-same-owner --transform 's,^filebrowser$,output/bin/filebrowser,' -xf filebrowser.tar.gz filebrowser
BUILD

SERVICE filebrowser
  IMPORT ${pkgs.bash} ${pkgs.cacert} ${pkgs.coreutils}
  COPY ${release}/output/bin/filebrowser /bin/filebrowser
  COPY ${src}/context/docker/alpine/init.sh /init.sh
  COPY ${src}/context/docker/alpine/healthcheck.sh /healthcheck.sh
  COPY ${src}/context/docker/common/defaults/settings.json /defaults/settings.json
  START bash /init.sh
  PORT http = 80
  STATEDIR /database
  STATEDIR /config
  STATEDIR /srv
  READINESS http://127.0.0.1:80/health IN 10s
  LIVENESS http://127.0.0.1:80/health EVERY 5s
