FROM github:NixOS/nixpkgs/nixos-unstable AS pkgs

BUILDER build
  IMPORT ${pkgs.bash} ${pkgs.nodejs} ${pkgs.pnpm} ${pkgs.coreutils} ${pkgs.gnused} ${pkgs.cacert} ${pkgs.glibc}
  ENV NPM_CONFIG_LOGLEVEL=warn
  ENV CI=true
  COPY context/package.json .
  COPY context/pnpm-lock.yaml .
  FETCH pnpm fetch --frozen-lockfile
  COPY context/ .
  RUN pnpm install --offline --frozen-lockfile && pnpm build

SERVICE web
  IMPORT ${pkgs.bash} ${pkgs.nginx}
  COPY ${build}/dist /usr/share/nginx/html
  COPY nginx.conf /etc/nginx/nginx.conf
  COPY start-nginx /bin/start-nginx
  START bash /bin/start-nginx
  PORT http = 80
  RUNDIR /var/log/nginx
  RUNDIR /run/nginx
