FROM github:NixOS/nixpkgs/nixos-unstable AS pkgs
FROM . AS src

BUILDER pnpm-store
  IMPORT ${pkgs.pnpm} ${pkgs.nodejs_24} ${pkgs.bash} ${pkgs.cacert}
  COPY ${src}/context/pnpm-lock.yaml .
  COPY ${src}/context/pnpm-workspace.yaml .
  COPY ${src}/context/package.json .
  FETCH pnpm --pm-on-fail=ignore fetch --frozen-lockfile --ignore-scripts --store-dir pnpm-store

BUILDER web
  IMPORT ${pkgs.pnpm} ${pkgs.nodejs_24} ${pkgs.bash} ${pkgs.cacert}
  COPY ${src}/context/pnpm-lock.yaml .
  COPY ${src}/context/pnpm-workspace.yaml .
  COPY ${src}/context/package.json .
  RUN <<INSTALL
pnpm --pm-on-fail=ignore config set pm-on-fail ignore --location project
pnpm config set frozen-store true --location project
pnpm config set store-dir ${pnpm-store}/pnpm-store --location project
pnpm install --offline --frozen-lockfile --frozen-store --ignore-scripts
INSTALL
  COPY ${src}/context/vite.config.ts .
  COPY ${src}/context/tsconfig.json .
  COPY ${src}/context/.prettierrc.cjs .
  COPY ${src}/context/.npmrc .
  COPY ${src}/context/assets assets
  COPY ${src}/context/locales locales
  COPY ${src}/context/public public
  ENV CI=true
  ENV CLOUD_URL=
  RUN pnpm build

BUILDER go-build
  IMPORT ${pkgs.bash} ${pkgs.go_1_26} ${pkgs.openssl} ${pkgs.cacert}
  COPY ${src}/context/go.mod .
  COPY ${src}/context/go.sum .
  FETCH go mod download
  COPY ${src}/context/internal internal
  COPY ${src}/context/proto proto
  COPY ${src}/context/types types
  COPY ${src}/context/main.go .
  COPY ${src}/context/protos protos
  COPY ${web}/dist dist
  RUN openssl genpkey -algorithm Ed25519 -out shared_key.pem
  RUN openssl req -new -key shared_key.pem -out shared_request.csr -subj "/C=US/ST=California/L=San Francisco/O=Dozzle"
  RUN openssl x509 -req -in shared_request.csr -signkey shared_key.pem -out shared_cert.pem -days 1825 && rm shared_request.csr
  RUN GOOS=linux GOARCH=amd64 CGO_ENABLED=0 go build -ldflags "-s -w -X github.com/amir20/dozzle/internal/support/cli.Version=dev" -o dozzle

SERVICE dozzle
  COPY ${go-build}/dozzle /dozzle
  START /dozzle
  PORT http = 8080
  STATEDIR /data
  DIR /var/run/docker.sock:ro
