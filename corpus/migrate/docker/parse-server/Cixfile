FROM github:NixOS/nixpkgs/nixos-unstable AS pkgs
FROM . AS src

BUILDER build
  IMPORT ${pkgs.bash} ${pkgs.cacert} ${pkgs.coreutils} ${pkgs.nodejs_22}
  COPY ${src}/context/ .
  ENV npm_config_fetch_retries=5
  ENV npm_config_fetch_retry_mintimeout=60000
  ENV npm_config_fetch_retry_maxtimeout=300000
  ENV npm_config_cache=/tmp/parse-server-npm-cache
  RUN rm -rf .npm
  RUN mkdir -p node_modules prod_node_modules && rm -rf node_modules prod_node_modules
  FETCH npm ci --include=dev --ignore-scripts
  RUN npm run build
  RUN mv node_modules prod_node_modules
  RUN mkdir -p node_modules && touch node_modules/.cix-keep

SERVICE parse-server
  IMPORT ${pkgs.nodejs_22}
  COPY ${build}/prod_node_modules /parse-server/node_modules
  COPY ${build}/lib /parse-server/lib
  COPY ${build}/package.json /parse-server/package.json
  COPY ${build}/package-lock.json /parse-server/package-lock.json
  COPY ${src}/context/bin /parse-server/bin
  COPY ${src}/context/public /parse-server/public
  COPY ${src}/context/views /parse-server/views
  START node ./bin/parse-server
  ENV PORT=1337
  PORT http = $PORT
  STATEDIR /parse-server/cloud
  CONFIGDIR /parse-server/config
  CLAIM egress
