FROM github:NixOS/nixpkgs/nixos-unstable AS pkgs
FROM . AS src

SERVICE streaming
  IMPORT ${pkgs.bash} ${pkgs.nginx} ${pkgs.postgresql} ${pkgs.redis}
  COPY ${src}/nginx.conf /etc/nginx/nginx.conf
  COPY ${src}/verify-dependencies.sh /opt/mastodon/verify-dependencies.sh
  START_PRE bash /opt/mastodon/verify-dependencies.sh psql redis-cli
  START nginx -c /etc/nginx/nginx.conf -e stderr
  SECRET db-password
  PORT streaming = 34000
  CACHEDIR /var/cache/nginx
  RUNDIR /run/nginx
  READINESS http://127.0.0.1:34000/api/v1/streaming/health IN 30s
