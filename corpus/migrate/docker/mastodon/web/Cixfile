FROM github:NixOS/nixpkgs/nixos-unstable AS pkgs
FROM . AS src

SERVICE web
  IMPORT ${pkgs.postgresql} ${pkgs.python3} ${pkgs.redis}
  COPY ${src}/web.py /opt/mastodon/web.py
  START python3 /opt/mastodon/web.py psql redis-cli
  SECRET db-password
  PORT http = 33000
  STATEDIR /mastodon/public/system
  READINESS http://127.0.0.1:33000/health IN 30s
  LIVENESS notify EVERY 2s
  CLAIM egress
