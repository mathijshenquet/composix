FROM github:NixOS/nixpkgs/nixos-unstable AS pkgs
FROM . AS src

SERVICE sidekiq
  IMPORT ${pkgs.postgresql} ${pkgs.python3} ${pkgs.redis}
  COPY ${src}/worker.py /opt/mastodon/worker.py
  START python3 /opt/mastodon/worker.py psql redis-cli
  SECRET db-password
  PORT control = 33001
  STATEDIR /mastodon/public/system
  READINESS tcp://127.0.0.1:33001 IN 30s
  LIVENESS notify EVERY 2s
  CLAIM egress
