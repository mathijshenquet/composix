FROM github:NixOS/nixpkgs/nixos-unstable AS pkgs
FROM . AS src

SERVICE postgres
  IMPORT ${pkgs.bash} ${pkgs.coreutils} ${pkgs.postgresql}
  COPY ${src}/runtime-env.sh /opt/postgres/runtime-env.sh
  COPY ${src}/setup.sh /opt/postgres/setup.sh
  COPY ${src}/start.sh /opt/postgres/start.sh
  COPY ${pkgs.nss_wrapper}/lib/libnss_wrapper.so /opt/postgres/libnss_wrapper.so
  START_PRE bash /opt/postgres/setup.sh
  START bash /opt/postgres/start.sh postgres
  ENV LANG=C
  ENV LC_ALL=C
  SECRET db-password
  PORT postgres = 35432
  STATEDIR /var/lib/postgresql
  RUNDIR /run/postgresql
  READINESS tcp :35432 IN 30s
