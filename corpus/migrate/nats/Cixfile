FROM github:NixOS/nixpkgs/nixos-unstable AS pkgs

BUILDER runtime
  IMPORT ${pkgs.bash} ${pkgs.curl} ${pkgs.cacert} ${pkgs.coreutils} ${pkgs.gnutar} ${pkgs.gzip}
  ENV NATS_SERVER = 2.12.14
  ENV NATS_ARCH = amd64
  ENV NATS_SHA256 = 84e7251f6a745e5950b9adf2159638a29fbfdcec040c13674b2362a3446b4eaa
  FETCH curl --fail --location https://github.com/nats-io/nats-server/releases/download/v$NATS_SERVER/nats-server-v$NATS_SERVER-linux-$NATS_ARCH.tar.gz --output nats-server.tar.gz && chmod 644 nats-server.tar.gz && touch -d @0 nats-server.tar.gz EXPECT sha256-kqUeAFIPk6wGUFYrYQQX/bBX6ryPdaCOUuLCbWjc838=
  RUN <<BUILD
echo "$NATS_SHA256 *nats-server.tar.gz" | sha256sum -c -
rm -rf output
mkdir -p output/bin
tar -xOf nats-server.tar.gz "nats-server-v$NATS_SERVER-linux-$NATS_ARCH/nats-server" > output/bin/nats-server
chmod +x output/bin/nats-server
BUILD

SERVICE nats
  IMPORT ${pkgs.cacert} ${pkgs.tzdata}
  ENV NATS_SERVER = 2.12.14
  COPY ${runtime}/output/bin/nats-server /bin/nats-server
  START nats-server --http_port 8222
  PORT client = 4222
  PORT monitor = 8222
  PORT cluster = 6222
  CLAIM egress
