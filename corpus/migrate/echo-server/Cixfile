FROM github:NixOS/nixpkgs/nixos-unstable AS pkgs

BUILDER dependencies-direct
  IMPORT ${pkgs.nodejs} ${pkgs.coreutils} ${pkgs.bash} ${pkgs.cacert}
  ENV npm_config_cache = /tmp/cix-echo-server-npm-cache
  ENV npm_config_logs_dir = /tmp/cix-echo-server-npm-logs
  COPY context/package.json package.json
  COPY context/package-lock.json package-lock.json
  COPY install-dependencies.sh install-dependencies.sh
  FETCH bash install-dependencies.sh --direct EXPECT sha256-MFqh9XfZ43Pa4nlE/vi0Q081ZpscMZtMTn0qv7vRubQ=

BUILDER build-output
  IMPORT ${pkgs.nodejs} ${pkgs.coreutils} ${pkgs.bash}
  ENV npm_config_cache = /tmp/cix-echo-server-npm-cache
  ENV npm_config_logs_dir = /tmp/cix-echo-server-npm-logs
  COPY ${dependencies-direct}/node_modules node_modules
  COPY context/package.json package.json
  COPY context/src src
  COPY context/webpack.config.js webpack.config.js
  RUN npm run build

SERVICE echo-server
  IMPORT ${pkgs.nodejs}
  COPY ${build-output}/dist/webserver.js /app/webserver.js
  COPY ${build-output}/src/global.json /app/global.json
  START node /app/webserver.js
  ENV PORT = 80 required
  PORT http = $PORT
  CLAIM jit
