FROM github:NixOS/nixpkgs/nixos-unstable AS pkgs

BUILDER build
  IMPORT ${pkgs.bash} ${pkgs.git} ${pkgs.nodejs} ${pkgs.cacert}
  ENV NPM_CONFIG_CACHE = $PWD/.npm
  FETCH git clone https://github.com/Ealenn/Echo-Server.git . && git checkout 2b735482f942cbd889f1d49f3ff892364d0519ac
  FETCH npm ci --ignore-scripts --no-audit --no-fund
  RUN npm ci --offline --ignore-scripts --no-audit --no-fund && npm run build

SERVICE echo-server
  COPY ${build}/src/global.json /global.json
  COPY ${build}/dist/webserver.js /webserver.js
  LINK ${pkgs.nodejs}/bin/node /bin/node
  EXEC node webserver.js
  PORT http = 80
  GRANT jit
