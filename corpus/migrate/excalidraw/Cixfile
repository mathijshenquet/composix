FROM github:NixOS/nixpkgs/nixos-unstable AS pkgs
FROM . AS src

BUILDER build
IMPORT ${pkgs.bash} ${pkgs.coreutils} ${pkgs.nodejs_24} ${pkgs.yarn} \
    ${pkgs.python3} ${pkgs.gnumake} ${pkgs.gcc} ${pkgs.git} ${pkgs.cacert}
COPY ${src}/context/ .
FETCH yarn --frozen-lockfile --network-timeout 600000
RUN yarn build:app:docker

SERVICE excalidraw
COPY ${build}/excalidraw-app/build /srv/www
COPY nginx.conf /etc/nginx/nginx.conf
LINK ${pkgs.nginx}/conf/mime.types /etc/nginx/mime.types
START ${pkgs.nginx}/bin/nginx -c /etc/nginx/nginx.conf -e stderr
PORT http = 18090
CACHEDIR /var/cache/nginx
RUNDIR /run/nginx
