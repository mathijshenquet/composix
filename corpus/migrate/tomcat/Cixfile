FROM github:NixOS/nixpkgs/nixos-unstable AS pkgs

SERVICE tomcat
  IMPORT ${pkgs.tomcat10} ${pkgs.jdk21} ${pkgs.coreutils}
  COPY ${pkgs.tomcat10} /share/tomcat
  ENV CATALINA_HOME = /share/tomcat
  ENV TOMCAT_NATIVE_LIBDIR = /share/tomcat/native-jni-lib
  ENV LD_LIBRARY_PATH = /share/tomcat/native-jni-lib
  ENV TOMCAT_MAJOR = 10
  ENV TOMCAT_VERSION = 10.1.57
  ENV TOMCAT_SHA512 = 2fa1866ec647d4222b07ea937a4cc266adee219a1a8870107e72fc2349248dd1e32b157fa18108451f4c6e3b162f0fdfbdd11dd7855d4e49a2f0f609004a77f3
  START catalina.sh run
  PORT http = 8080
  PORT shutdown = 8005
  CLAIM jit
