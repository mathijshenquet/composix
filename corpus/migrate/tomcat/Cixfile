FROM github:NixOS/nixpkgs/nixos-unstable AS pkgs

SERVICE tomcat
  COPY ${pkgs.coreutils} /coreutils
  COPY ${pkgs.gnused} /gnused
  COPY ${pkgs.tomcat10} /tomcat
  COPY ${pkgs.jdk21_headless} /jre
  COPY setup.sh /bin/tomcat-setup
  LINK ${pkgs.tomcat10}/bin/catalina.sh /bin/catalina.sh
  STATEDIR /var/lib/tomcat
  LOGDIR /var/log/tomcat
  RUNDIR /run/tomcat
  ENV CATALINA_HOME = /tomcat
  ENV CATALINA_BASE = /var/lib/tomcat
  ENV CATALINA_TMPDIR = /run/tomcat
  ENV JRE_HOME = /jre
  ENV PATH = /coreutils/bin:/gnused/bin:/bin
  START_PRE ${pkgs.bash}/bin/sh /bin/tomcat-setup
  START ${pkgs.bash}/bin/sh /tomcat/bin/catalina.sh run
  PORT http = 8080
  CLAIM jit
