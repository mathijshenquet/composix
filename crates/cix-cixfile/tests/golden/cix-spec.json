{
  "cixSpec": 2,
  "services": {
    "app": {
      "dirs": {
        "cache": [
          "/var/cache/app"
        ],
        "config": [
          "/etc/app"
        ],
        "logs": [
          "/var/log/app"
        ],
        "run": [
          "/run/app"
        ],
        "state": [
          "/var/lib/app"
        ]
      },
      "env": {
        "PORT": {
          "default": "9000",
          "required": true
        },
        "TOKEN": {
          "secret": true
        }
      },
      "exec": [
        "bin/app",
        "$PORT"
      ],
      "jit": true,
      "ports": {
        "http": {
          "env": "PORT",
          "protocol": "tcp"
        }
      },
      "setup": [
        "bin/setup"
      ]
    }
  }
}
