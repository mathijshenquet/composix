{
  "cixManifest": 5,
  "dirs": {
    "cache": [
      "/var/cache/app"
    ],
    "config": [
      "/etc/app"
    ],
    "logs": [
      "/var/log/app"
    ],
    "run": [
      "/run/app"
    ],
    "state": [
      "/var/lib/app"
    ]
  },
  "env": {
    "PATH": {
      "default": "/tools/first:/tools/second"
    },
    "PORT": {
      "default": "9000",
      "required": true
    },
    "TOKEN": {
      "secret": true
    }
  },
  "exec": [
    "bin/app",
    "$PORT"
  ],
  "grants": [
    "jit"
  ],
  "ports": {
    "http": {
      "env": "PORT",
      "protocol": "tcp"
    }
  },
  "setup": [
    "bin/setup"
  ]
}
