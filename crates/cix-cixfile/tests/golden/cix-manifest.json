{
  "cixManifest": 0,
  "dirs": {
    "cache": [
      "/var/cache/app"
    ],
    "config": [
      "/etc/app"
    ],
    "data": [
      {
        "path": "/consume",
        "ro": false
      },
      {
        "path": "/media",
        "ro": true
      }
    ],
    "logs": [
      "/var/log/app"
    ],
    "run": [
      "/run/app"
    ],
    "state": [
      "/var/lib/app"
    ]
  },
  "env": {
    "PATH": {
      "default": "/tools/first:/tools/second"
    },
    "PORT": {
      "default": "9000",
      "required": true
    },
    "TOKEN": {
      "secret": true
    }
  },
  "start": [
    "bin/app",
    "$PORT"
  ],
  "readiness": {
    "target": ":9000/healthz",
    "timeout": "90s",
    "type": "http"
  },
  "liveness": {
    "interval": "10s",
    "target": ":9000",
    "type": "tcp"
  },
  "claims": [
    "jit"
  ],
  "ports": {
    "http": {
      "env": "PORT",
      "protocol": "tcp"
    },
    "http3": {
      "protocol": "udp",
      "value": 8443
    }
  },
  "start_pre": [
    "bin/setup"
  ]
}
