FROM github:NixOS/nixpkgs/nixos-unstable AS pkgs
SERVICE app
ENV PATH = /tools/first:/tools/second
START app $PORT
START_PRE setup
ENV PORT = 9000 required
ENV TOKEN secret
PORT http = $PORT
PORT http3 = udp:8443
READINESS http :9000/healthz IN 90s
LIVENESS tcp :9000 EVERY 10s
STATEDIR /var/lib/app
CACHEDIR /var/cache/app
LOGDIR /var/log/app
CONFIGDIR /etc/app
RUNDIR /run/app
DIR /consume
DIR /media:ro
CLAIM jit
