{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://composix.dev/schema/compose-tree-v1.json",
  "title": "composix compose tree v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["cixCompose", "name", "children"],
  "properties": {
    "cixCompose": {"const": 1},
    "name": {"$ref": "#/$defs/name"},
    "logNamespace": {"type": "boolean", "default": false},
    "children": {"$ref": "#/$defs/children"},
    "edges": {"$ref": "#/$defs/edges"},
    "secrets": {"$ref": "#/$defs/secrets"},
    "network": {"enum": ["pod"]},
    "publish": {"$ref": "#/$defs/publishes"}
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
    "ref": {"type": "string", "pattern": "^.+:[^/:]+$"},
    "absolutePath": {"type": "string", "pattern": "^/"},
    "treePath": {"type": "string", "pattern": "^[a-z0-9._-]+(?:/[a-z0-9._-]+)*$"},
    "children": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {"$ref": "#/$defs/child"}
    },
    "child": {
      "oneOf": [
        {"$ref": "#/$defs/item"},
        {"$ref": "#/$defs/composeRef"},
        {"$ref": "#/$defs/group"}
      ]
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["children"],
      "properties": {
        "children": {"$ref": "#/$defs/children"},
        "edges": {"$ref": "#/$defs/edges"},
        "secrets": {"$ref": "#/$defs/secrets"},
        "network": {"enum": ["pod"]},
        "publish": {"$ref": "#/$defs/publishes"},
        "bind": {"$ref": "#/$defs/bindings"}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item"],
      "properties": {
        "item": {"$ref": "#/$defs/ref"},
        "update": {"enum": ["pin", "track"], "default": "pin"},
        "env": {"type": "object", "additionalProperties": {"type": "string"}},
        "bind": {"type": "object", "additionalProperties": {"type": "string"}},
        "dirs": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/absolutePath"},
          "additionalProperties": {"$ref": "#/$defs/directoryMaterialization"}
        },
        "identity": {"$ref": "#/$defs/name"},
        "schedule": {"type": "string", "minLength": 1},
        "persistent": {"type": "boolean"},
        "jitter": {"type": "string", "minLength": 1},
        "shm": {"type": "string", "minLength": 1},
        "egress": {"type": "boolean"}
      }
    },
    "composeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compose"],
      "properties": {
        "compose": {"$ref": "#/$defs/ref"},
        "update": {"enum": ["pin", "track"], "default": "pin"},
        "bind": {"$ref": "#/$defs/bindings"}
      }
    },
    "bindings": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {"type": "string"}
    },
    "publishes": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {"$ref": "#/$defs/publish"}
    },
    "publish": {
      "type": "object",
      "additionalProperties": false,
      "required": ["child", "port"],
      "properties": {
        "child": {"$ref": "#/$defs/name"},
        "port": {"$ref": "#/$defs/name"}
      }
    },
    "directoryMaterialization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {"$ref": "#/$defs/absolutePath"},
        "shared": {"$ref": "#/$defs/name"},
        "as": {"enum": ["state", "cache", "logs", "config", "run"]},
        "idmap": {"type": "boolean", "default": false},
        "write": {"type": "boolean", "default": false}
      },
      "anyOf": [{"required": ["host"]}, {"required": ["shared"]}, {"required": ["as"]}]
    },
    "secrets": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {"$ref": "#/$defs/secret"}
    },
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {"$ref": "#/$defs/absolutePath"},
        "encrypted": {"$ref": "#/$defs/absolutePath"}
      },
      "oneOf": [{"required": ["file"]}, {"required": ["encrypted"]}]
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["child", "path"],
      "properties": {
        "child": {"$ref": "#/$defs/name"},
        "path": {"$ref": "#/$defs/absolutePath"}
      }
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"path": {"$ref": "#/$defs/absolutePath"}}
    },
    "edges": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {"$ref": "#/$defs/edge"}
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "consumers"],
      "properties": {
        "producer": {"$ref": "#/$defs/endpoint"},
        "consumers": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/treePath"},
          "additionalProperties": {"$ref": "#/$defs/consumer"}
        }
      }
    }
  }
}
