{
  "cixManifest": 0,
      "start_pre": [
        "bin/setup",
        "--admin-port",
        "$ADMIN_PORT"
      ],
      "start": [
        "bin/web",
        "--admin-port",
        "$ADMIN_PORT"
      ],
      "env": {
        "ADMIN_PORT": {
          "default": "9000"
        }
      },
      "ports": {
        "http": {
          "value": 80,
          "protocol": "tcp"
        },
        "admin": {
          "env": "ADMIN_PORT",
          "protocol": "tcp"
        }
      },
      "dirs": {
        "run": [
          "/run/web"
        ]
      },
      "claims": ["jit"]
}
