[Unit]
Description=cix run: web

[Service]
Type=exec
Slice=cix-run.slice
LogExtraFields=CIX_RUN=cix-run-web.service CIX_ITEM=/nix/store/00000000000000000000000000000000-web
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivatePIDs=yes
PrivateDevices=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
PrivateNetwork=yes
SocketBindDeny=any
ExecStart="/nix/store/00000000000000000000000000000000-web/bin/web"
