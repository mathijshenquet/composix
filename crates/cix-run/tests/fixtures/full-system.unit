[Unit]
Description=cix run: web

[Service]
Type=exec
Slice=cix-run.slice
TemporaryFileSystem=/var/lib:ro
StateDirectory=cix-run-web/var/lib/state cix-run-web/var/lib/uploads
StateDirectoryMode=0700
BindPaths=/var/lib/cix-run-web/var/lib/state:/var/lib/state
BindPaths=/var/lib/cix-run-web/var/lib/uploads:/var/lib/uploads
TemporaryFileSystem=/var/cache:ro
CacheDirectory=cix-run-web/var/cache/cache
CacheDirectoryMode=0700
BindPaths=/var/cache/cix-run-web/var/cache/cache:/var/cache/cache
TemporaryFileSystem=/var/log:ro
LogsDirectory=cix-run-web/var/log/log
LogsDirectoryMode=0700
BindPaths=/var/log/cix-run-web/var/log/log:/var/log/log
TemporaryFileSystem=/etc:ro
ConfigurationDirectory=cix-run-web/etc/config
ConfigurationDirectoryMode=0700
BindPaths=/etc/cix-run-web/etc/config:/etc/config
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivatePIDs=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SocketBindAllow=tcp:9090
SocketBindDeny=any
ExecStart="/nix/store/00000000000000000000000000000000-web/bin/web" "--port" "9090" "--database" "postgres://db/a b" "--enabled=true"
Environment="DB_URL=postgres://db/a b"
Environment="ENABLED=true"
Environment="PORT=9090"
Environment="ROOT=/srv/web"
Environment="STATE_DIRECTORY=/var/lib/state:/var/lib/uploads"
Environment="CACHE_DIRECTORY=/var/cache/cache"
Environment="LOGS_DIRECTORY=/var/log/log"
