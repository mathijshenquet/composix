[Unit]
Description=cix run: web

[Service]
Type=exec
Slice=cix-run.slice
LogExtraFields=CIX_RUN=cix-run-web.service CIX_ITEM=/nix/store/00000000000000000000000000000000-web
TemporaryFileSystem=/var/lib:ro
StateDirectory=cix-run-web/state-0:state cix-run-web/state-1:uploads
StateDirectoryMode=0700
TemporaryFileSystem=/var/cache:ro
CacheDirectory=cix-run-web:cache
CacheDirectoryMode=0700
TemporaryFileSystem=/var/log:ro
LogsDirectory=cix-run-web:log
LogsDirectoryMode=0700
ConfigurationDirectory=cix-run-web
ConfigurationDirectoryMode=0700
BindPaths=/etc/cix-run-web:/etc/config
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivatePIDs=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SocketBindAllow=tcp:9090
SocketBindDeny=any
ExecStart="/nix/store/00000000000000000000000000000000-web/bin/web" "--port" "9090" "--database" "postgres://db/a b" "--enabled=true"
Environment="DB_URL=postgres://db/a b"
Environment="ENABLED=true"
Environment="PORT=9090"
Environment="ROOT=/srv/web"
