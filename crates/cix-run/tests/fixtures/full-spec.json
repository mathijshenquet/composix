{
  "cixManifest": 0,
      "exec": [
        "bin/web",
        "--port",
        "$PORT",
        "--database",
        "$DB_URL",
        "--enabled=$ENABLED"
      ],
      "env": {
        "PORT": {
          "default": "8000"
        },
        "DB_URL": {
          "required": true,
          "secret": true
        },
        "ENABLED": {
          "default": "false"
        },
        "ROOT": {
          "default": "/srv/web"
        }
      },
      "ports": {
        "http": {
          "env": "PORT",
          "protocol": "tcp"
        }
      },
      "dirs": {
        "state": [
          "/var/lib/state",
          "/var/lib/uploads"
        ],
        "cache": [
          "/var/cache/cache"
        ],
        "logs": [
          "/var/log/log"
        ],
        "config": [
          "/etc/config"
        ]
      },
      "health": {
        "exec": [
          "bin/healthcheck",
          "$PORT"
        ],
        "interval": "30s"
      }
}
