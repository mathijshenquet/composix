[Unit]
Description=cix run: worker

[Service]
Type=exec
Slice=cix-run.slice
BindReadOnlyPaths=/nix/store/00000000000000000000000000000000-worker:/app
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
PrivateNetwork=yes
ExecStart="/nix/store/00000000000000000000000000000000-worker/bin/worker"
Environment="CIX_APP=/app"
