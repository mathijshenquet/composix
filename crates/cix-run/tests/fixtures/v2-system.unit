[Unit]
Description=cix run: web

[Service]
Type=exec
Slice=cix-run.slice
RuntimeDirectory=cix-run-web:web
RuntimeDirectoryMode=0700
BindReadOnlyPaths=/nix/store/00000000000000000000000000000000-web-v2:/item
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
SystemCallFilter=@system-service
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ExecStartPre="/nix/store/00000000000000000000000000000000-web-v2/bin/setup" "--admin-port" "9000"
ExecStart="/nix/store/00000000000000000000000000000000-web-v2/bin/web" "--admin-port" "9000"
Environment="ADMIN_PORT=9000"
Environment="CIX_ITEM=/item"
